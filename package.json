{
  "name": "Capdio",
  "version": "1.1.0",
  "description": "Capdio is for transcribe and play local audio/video files with interactive captions",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "vite",
    "build": "vite build",
    "build:python": "node scripts/build-python.js",
    "build:python:mac": "node scripts/build-python-universal.js",
    "download:model": "node scripts/download-model.js",
    "package:resources": "npm run build:python && npm run download:model",
    "package:resources:mac": "npm run build:python:mac && npm run download:model",
    "dist:win": "npm run build && npm run package:resources && electron-builder --win nsis",
    "dist:mac": "npm run build && npm run package:resources:mac && electron-builder --mac --universal",
    "repackage:win": "npm run build && electron-builder --win nsis",
    "repackage:mac": "npm run build && electron-builder --mac --universal"
  },
  "keywords": [],
  "author": "Jesse Shen",
  "license": "ISC",
  "type": "commonjs",
  "build": {
    "appId": "com.jesse-shen.capdio",
    "productName": "Capdio",
    "asar": true,
    "afterPack": "scripts/after-pack-mac.js",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "dictionary.js",
      "dictionary.html",
      "src/App.css",
      "upload.html",
      "package.json",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/capdio-icon.png",
      "extraResources": [
        {
          "from": "node_modules/ffmpeg-static/ffmpeg.exe",
          "to": "bin/win32-x64/ffmpeg.exe"
        },
        {
          "from": "node_modules/ffmpeg-static/ffmpeg.exe.LICENSE",
          "to": "licenses/ffmpeg-static.LICENSE"
        },
        {
          "from": "resources/bin/win32-x64",
          "to": "bin/win32-x64"
        },
        {
          "from": "resources/models",
          "to": "models"
        }
      ]
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/capdio-icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "installer.nsh"
    }
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^37.3.1",
    "electron-builder": "^26.15.3",
    "ffmpeg-static": "^5.3.0",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "lucide-react": "^1.45.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
